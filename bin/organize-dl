#!/usr/bin/env bash
# organize-dl - deprecated name for organize. Kept so old scripts keep working.
set -euo pipefail

printf 'organize-dl: deprecated, use organize instead\n' >&2

# Prefer the organize next to this script, so a checkout works without install.
sendiri=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
if [[ -x $sendiri/organize ]]; then
	bin=$sendiri/organize
else
	bin=organize
fi

# --dry-run and -n are the old spelling of --preview.
args=()
for a in "$@"; do
	case $a in
	-n | --dry-run) args+=(--preview) ;;
	*) args+=("$a") ;;
	esac
done

exec "$bin" ${args[@]+"${args[@]}"}
