# shellcheck shell=bash
# bash completion for organize
_organize() {
	local cur
	cur=${COMP_WORDS[COMP_CWORD]}

	case $cur in
	-*)
		mapfile -t COMPREPLY < <(compgen -W "-p --preview --images --documents --music --videos --archives --others --device -h --help -V --version --" -- "$cur")
		;;
	*)
		mapfile -t COMPREPLY < <(compgen -d -- "$cur")
		;;
	esac
}

complete -F _organize organize
